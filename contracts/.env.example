# =============================================================
# Blacklight Pool — Contract Deployment Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file with real secrets.
# =============================================================

# RPC URL for deployment (e.g. Anvil fork or Blacklight L2)
BLACKLIGHT_L2_RPC_URL=https://rpc-blacklight-x9da3b5afc.t.conduit.xyz

# Chain contracts (Blacklight L2)
NIL_TOKEN_ADDRESS=0x32DEAe728473cb948B4D8661ac0f2755133D4173
STAKING_CONTRACT_ADDRESS=0x89c1312Cedb0B0F67e4913D2076bd4a860652B69
REWARD_POLICY_ADDRESS=0x78E0FEBF3B8936f961729328a25dBA88d4Fea86B
# Heartbeat Manager (StakingOperators.heartbeatManager())
MANAGER_CONTRACT_ADDRESS=0x0Ee49a8f50293Fa5d05Ba6d1FC136e7F79b2eA4f

# Deployer (NEVER commit the real key)
DEPLOYER_PRIVATE_KEY=0xYourPrivateKeyHere

# Platform fee recipient (required). 1% of pool rewards goes here during reward distribution.
PLATFORM_FEE_RECIPIENT=0xYourPlatformFeeRecipientAddress

# Fork testing (fund_fork_accounts.sh, E2E tests)
# POOL_OWNER_ADDRESS: should have ≥3 ETH (use Anvil account, e.g. 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
# WHALE_ADDRESS: address on Blacklight L2 with NIL (find on Blockscout token holders)
# See Learning materials/11-e2e-blacklight-fork-testing.md
FRESH_OPERATOR_ADDRESS=0xYourFreshOperatorAddressHere
POOL_OWNER_ADDRESS=0xYourPoolOwnerAddressHere
FRESH_OPERATOR_2_ADDRESS=0xYourFreshOperatorAddressHere
POOL_OWNER_2_ADDRESS=0xYourPoolOwnerAddressHere
POOL_STAKER_ADDRESS=0xYourPoolStakerAddressHere
WHALE_ADDRESS=0xYourWhaleAddressHere
WHALE_ADDRESS_2=0xYourWhaleAddressHere