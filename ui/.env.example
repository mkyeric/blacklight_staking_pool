# =============================================================
# Blacklight Pool — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================

# WalletConnect Project ID (free at https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Network: "local" = Anvil fork (chain 4811, http://127.0.0.1:8545). Omit or "production" = live (98875).
# NEXT_PUBLIC_BLACKLIGHT_NETWORK=local

# Pool factory (required for Create Pool wizard and pool list)
# Deploy via: forge script script/Deploy.s.sol:DeployBlacklightPool --rpc-url ... --broadcast
NEXT_PUBLIC_POOL_FACTORY_ADDRESS=0xYourPoolFactoryAddressHere

# Show "Create Pool" tab (set to "false" to build a staker-only UI without pool creation)
# NEXT_PUBLIC_SHOW_CREATE_POOL=false
