# =============================================================
# Blacklight Pool — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================

# WalletConnect Project ID (free at https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Pool factory (required for Create Pool wizard and pool list)
# Deploy via: forge script script/Deploy.s.sol:DeployBlacklightPool --rpc-url ... --broadcast
NEXT_PUBLIC_POOL_FACTORY_ADDRESS=0xYourPoolFactoryAddressHere
